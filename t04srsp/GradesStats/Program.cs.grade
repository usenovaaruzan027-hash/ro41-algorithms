using System;

namespace GradesStats
{
    public static class Grades
    {
        public const int Min = 2;
        public const int Max = 5;
        public const int Stop = 0;
        public static int Read()
        {
            string input = Console.ReadLine();
            if (int.TryParse(input, out int result))
            {
                return result;
            }
            return -1;
        }
        public static bool IsValid(int g)
        {
            return g >= Min && g <= Max;
        }
        public static void PrintStats(int count, int sum, int Fives)
        {
            if (count == 0)
            {
                Console.WriteLine("Оценок нет");
            }
            else
            {
                double average = (double)sum / count;
                Console.WriteLine($"Всего оценок: {count}");
                Console.WriteLine($"Сумма баллов: {sum}");
                Console.WriteLine($"Количество пятерок: {Fives}");
                Console.WriteLine($"Средний балл: {average:F2}");
            }
        }
    }

    class Program
    {
        static void Main(string[] args)
        {
            Console.OutputEncoding = System.Text.Encoding.UTF8;

            int count = 0;
            int sum = 0;
            int fivesCount = 0;

            Console.WriteLine("Введите оценки (для завершения введите 0, некорректный ввод игнорируется):");

            while (true)
            {
                int grade = Grades.Read();
                if (grade == Grades.Stop)
                {
                    break;
                }
                if (Grades.IsValid(grade))
                {
                    count++;
                    sum += grade;
                    if (grade == Grades.Max)
                    {
                        fivesCount++;
                    }
                }
                else
                {
                    {
                    }
                }
            }

            Grades.PrintStats(count, sum, fivesCount);
        }
    }
}